# Assistant answers: independent of the ingestion/profile provider below.
# Add your temporary testing key to .env only; never commit a real key here.
ASSISTANT_BASE_URL=https://api.openai.com/v1
ASSISTANT_MODEL=gpt-6.1-sol
ASSISTANT_REASONING_EFFORT=medium
ASSISTANT_API_KEY=

# Local database and current RAG embedding service.
DATABASE_URL=postgresql+psycopg://hoso:hoso_local@localhost:55432/hoso
RAG_EMBED_URL=http://localhost:11434
EMBED_MODEL=bge-m3
# Similarity thresholds and model digests are stored per retrieval release.

# Compatibility embedding helper; the versioned RAG engine uses RAG_EMBED_URL.
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_API_KEY=ollama

# Ingestion/profile and blank public form mapping; personal form filling never
# calls a model. Use codex here for the signed-in Codex CLI instead of the API.
FIELD_MAPPING_PROVIDER=openai
FIELD_MAPPING_MODEL=gpt-6-astra
FIELD_MAPPING_REASONING=high
PROFILE_MODEL=gpt-6-astra
PROFILE_REASONING=high
# Used by the openai ingestion provider; also an assistant fallback only when
# ASSISTANT_BASE_URL is the default OpenAI URL and ASSISTANT_API_KEY is empty.
OPENAI_API_KEY=

# Optional persistent secrets for multi-worker deployments. Blank means random
# process-local secrets: clarification/review tokens become invalid on restart.
RAG_STATE_SECRET=
FORM_REVIEW_SECRET=

# Set an installed font directory on non-Windows deployments. Windows defaults
# to C:/Windows/Fonts, mounted read-only for document conversion; no fonts copied.
# FORM_FONT_DIR=/path/to/licensed/fonts
# Unit tests set HOSO_LOAD_DOTENV=0 in the process before importing the app.
# Do not put that flag in .env: it controls whether the file is read at all.
