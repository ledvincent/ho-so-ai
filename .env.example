DATABASE_URL=postgresql+psycopg://hoso:hoso_local@localhost:55432/hoso
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_MODEL=bge-m3
EMBED_API_KEY=ollama
# Set only after held-out calibration; search otherwise returns HTTP 503.
# SEARCH_MIN_SIMILARITY=0.75

# Blank public form mapping; personal form filling never calls a model.
FIELD_MAPPING_PROVIDER=openai
FIELD_MAPPING_MODEL=gpt-6-astra
FIELD_MAPPING_REASONING=high
# Procedure profile / catalog comparison use the same provider by default.
PROFILE_MODEL=gpt-6-astra
PROFILE_REASONING=high
# OPENAI_API_KEY=...
# Assistant generation is independent of ingestion/profile models.
# Set an explicit model before using POST /assistant/chat.
ASSISTANT_BASE_URL=https://api.openai.com/v1
ASSISTANT_MODEL=gpt-4o-mini
# ASSISTANT_API_KEY=...
# OPENAI_API_KEY is a fallback only for the default OpenAI base URL.
# Local prototype alternative: FIELD_MAPPING_PROVIDER=codex (signed-in Codex CLI).
# Set an installed font directory on non-Windows deployments. Windows defaults
# to C:/Windows/Fonts, mounted read-only for document conversion; no fonts copied.
# FORM_FONT_DIR=/path/to/licensed/fonts
